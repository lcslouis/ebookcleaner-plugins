{
  "id": "goodnovel",
  "name": "GoodNovel",
  "version": "1.0.0",
  "author": "bundled",
  "description": "Bundled plugin migrated from built-in configs",
  "domains": ["goodnovel.com"],
  "toc_selectors": ["div.catalog-box a", "ul.catalog-list a"],
